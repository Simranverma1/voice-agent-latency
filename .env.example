# Copy this file to ".env" and fill it in.

GROQ_API_KEY=gsk_...
DEEPGRAM_API_KEY=...

# Fill these in AFTER running: python fix_mic.py
# MIC_DEVICE       = the index it recommends
# MIC_NATIVE_RATE  = capture rate; MUST be a whole multiple of 16000.
#                    Use 48000 if offered. Leave unset if your mic does 16000.
MIC_DEVICE=
MIC_NATIVE_RATE=48000
